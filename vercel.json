{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/mac",
      "destination": "https://mac-ochre.vercel.app",
      "permanent": true
    },
    {
      "source": "/mac/:path*",
      "destination": "https://mac-ochre.vercel.app/:path*",
      "permanent": true
    }
  ]
}
